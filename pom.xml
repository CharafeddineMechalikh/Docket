<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.charafeddinemechalikh</groupId>
	<artifactId>docket</artifactId>
	<version>1.0.1</version>
	<name>Docket</name>
	<description>Research-grade discrete-event simulator for generative AI (LLM) inference serving, built on the PureEdgeSim engine</description>
	<url>https://github.com/CharafeddineMechalikh/Docket</url>

	<licenses>
		<license>
			<name>GPLv3</name>
			<url>http://www.gnu.org/licenses/gpl-3.0.txt</url>
		</license>
	</licenses>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>11</maven.compiler.release>
		<pureedgesim.version>6.0</pureedgesim.version>
		<junit.version>5.8.2</junit.version>
		<mainClass>com.mechalikh.docket.cli.Main</mainClass>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.0.0-M5</version>
				<configuration>
					<forkCount>1</forkCount>
					<reuseForks>true</reuseForks>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.2.0</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>${mainClass}</mainClass>
							<!-- The classpath entries are relative to the jar, so that the
							manifest stays valid on every 
								machine. An absolute prefix is read as a URL by javac,
								which then refuses to open the jar built by this
							project. -->
							<addClasspath>true</addClasspath>
							<classpathLayoutType>simple</classpathLayoutType>
							<classpathPrefix>lib/</classpathPrefix>
							<!-- Stamps the artifact with its own version, which the CLI and the
							artifacts print. -->
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
					</archive>
				</configuration>
			</plugin>

			<!-- Fills target/lib so that the packaged jar runs with java -jar. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>2.8</version>
				<executions>
					<execution>
						<id>copy-runtime-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<includeScope>runtime</includeScope>
							<excludeTransitive>false</excludeTransitive>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<mainClass>${mainClass}</mainClass>
				</configuration>
			</plugin>

			<!-- The policies the examples write are compiled as test sources: they are part of the
			test run, they are exercised by the example tests, and they never enter the jar, so a
			user copies one file rather than inheriting an example into the artifact. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>example-policy-sources</id>
						<phase>generate-test-sources</phase>
						<goals>
							<goal>add-test-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>examples/01-sla-earliest-deadline-first/src/main/java</source>
								<source>examples/02-sla-admission-protection/src/main/java</source>
								<source>examples/03-class-fair-share/src/main/java</source>
								<source>examples/04-session-affinity/src/main/java</source>
								<source>examples/05-weighted-load-routing/src/main/java</source>
								<source>examples/09-custom-policy-template/src/main/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Every public type and member carries Javadoc, so the API pages are complete.
			The missing-tag and HTML checks are relaxed because the GPL header of each file
			contains a literal URL in angle brackets, which the strict HTML check reads as a
			malformed tag. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.3.2</version>
				<configuration>
					<doclint>all,-missing,-html</doclint>
					<quiet>true</quiet>
					<notimestamp>true</notimestamp>
					<source>11</source>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- The PureEdgeSim discrete-event engine, distributions and randomness source. -->
		<dependency>
			<groupId>io.github.charafeddinemechalikh</groupId>
			<artifactId>pureedgesim</artifactId>
			<version>${pureedgesim.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
